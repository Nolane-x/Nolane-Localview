{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalView",
  "version": "0.2.0",
  "identifier": "com.nolane.localview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalView",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability", "preview-bridge-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI-native localhost visual runtime",
    "longDescription": "Automatically discovers local web applications and exposes a lightweight native preview plus an AI-native observation and control plane."
  }
}
