{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalView",
  "version": "0.2.0",
  "identifier": "com.nolane.localview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LocalView",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'self' http://localhost:* http://127.0.0.1:*"
      },
      "capabilities": [
        "main-capability",
        "preview-bridge-capability"
      ],
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI-native localhost visual runtime",
    "longDescription": "Automatically discovers local web applications and exposes a lightweight native preview plus an AI-native observation and control plane.",
    "resources": {
      "resources/wave6/axe.min.js": "wave6/axe.min.js",
      "resources/wave6/axe-core-LICENSE": "wave6/axe-core-LICENSE"
    }
  }
}
